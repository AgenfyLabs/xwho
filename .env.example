NEXT_PUBLIC_APP_URL=http://localhost:3000

# X OAuth 2.0 + PKCE 仅请求 users.read 和 tweet.read。公开客户端可留空 X_CLIENT_SECRET。
X_CLIENT_ID=
X_CLIENT_SECRET=
# 至少 32 字节随机密钥
SESSION_SECRET=

GITHUB_TOKEN=
GITHUB_REPO_OWNER=AgenfyLabs
GITHUB_REPO_NAME=xwho
GITHUB_BASE_BRANCH=main
# 默认仅预览。验收后可选 pr 或 direct，已确认的入库申请只走 PR。
GITHUB_WRITE_MODE=preview
